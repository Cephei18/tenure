pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";
import {Range} from "../../src/libraries/PositionValue.sol";

/// @dev Helpers to read decimal-string fields from test/vectors/*.json (generated by sim/gen_vectors.py).
///      The JSON is kept in MEMORY and passed around: a storage string would cost thousands of SLOADs per read.
abstract contract VectorReader is Test {
    function _load(string memory name) internal view returns (string memory) {
        return vm.readFile(string.concat(vm.projectRoot(), "/test/vectors/", name, ".json"));
    }

    function _count(string memory j) internal pure returns (uint256) {
        return vm.parseJsonUint(j, ".count");
    }

    function _key(uint256 i, string memory field) internal pure returns (string memory) {
        return string.concat(".cases[", vm.toString(i), "].", field);
    }

    function _u(string memory j, uint256 i, string memory field) internal pure returns (uint256) {
        return vm.parseJsonUint(j, _key(i, field));
    }

    function _i(string memory j, uint256 i, string memory field) internal pure returns (int256) {
        return vm.parseJsonInt(j, _key(i, field));
    }

    function _b(string memory j, uint256 i, string memory field) internal pure returns (bool) {
        return vm.parseJsonBool(j, _key(i, field));
    }

    function _range(string memory j, uint256 i, string memory obj) internal pure returns (Range memory) {
        return Range(
            int24(_i(j, i, string.concat(obj, ".tickLower"))),
            int24(_i(j, i, string.concat(obj, ".tickUpper"))),
            uint128(_u(j, i, string.concat(obj, ".liquidity")))
        );
    }

    function _msg(string memory what, uint256 i) internal pure returns (string memory) {
        return string.concat(what, " case ", vm.toString(i));
    }
}
