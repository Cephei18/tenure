# ---- Foundry ----
cache/
out/
# Broadcasts: keep real deployment records (run-*.json, run-latest.json on testnets);
# ignore local-chain runs, dry runs and lock files.
!/broadcast
/broadcast/*/31337/
/broadcast/*/5/
/broadcast/**/dry-run/
*.recovery.lock
# Rehearsal deployment outputs (real broadcasts write deployments/<chainId>.json, which are committed)
deployments/*.dryrun.json

# ---- Env and secrets ----
.env
.env.*
*.key
*.pem
keystore/
keystores/

# ---- Node ----
node_modules/
dist/
.vite/
.vercel/
.pnpm-store/

# ---- Python ----
__pycache__/
.pytest_cache/
*.pyc

# ---- OS and editors ----
.DS_Store
Thumbs.db
~$*
.idea/
.vscode/*
!.vscode/settings.json

# ---- Logs ----
*.log
preview.log

# ---- Development tooling (kept outside the repo) ----
CLAUDE.md
CLAUDE.local.md
PROMPT.md
PLAN.md
loop.sh
STOP
.claude/
.loop-logs/
docs/dev-log/
docs/slides/
